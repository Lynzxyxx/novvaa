<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Bulatan gelembung utama (bisa diseret, tap buka panel aksi) -->
    <ImageView
        android:id="@+id/bubbleIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="6dp"
        android:background="@drawable/bg_bubble_circle"
        android:src="@mipmap/ic_launcher"
        android:elevation="8dp"
        android:contentDescription="@string/app_name" />

    <!-- Cincin loading, muncul saat lagi scan/menunggu jawaban AI -->
    <ProgressBar
        android:id="@+id/bubbleLoading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/novaFuchsia"
        android:visibility="gone" />

    <!-- Badge amplop kecil, muncul kalau jawaban sudah siap dibaca -->
    <TextView
        android:id="@+id/bubbleBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="end|top"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:text="✉️"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Panel aksi kecil: tombol Scan Layar & Tutup gelembung -->
    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="10dp"
        android:elevation="10dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_button"
            android:textAllCaps="false"
            android:backgroundTint="@color/novaIndigo"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCloseBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/close_button"
            android:textAllCaps="false"
            android:backgroundTint="#E5E7EB"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- Panel hasil jawaban (ringkas) -->
    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:text="" />

        <Button
            android:id="@+id/btnCloseResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/close_button"
            android:textAllCaps="false"
            android:backgroundTint="#E5E7EB"
            android:textColor="@color/black" />
    </LinearLayout>

</FrameLayout>
