# ==== AI API (dari provider kamu) ====
CHAT_API_BASE_URL=https://bandelbanget.xyz/v1
CHAT_API_KEY=isi-dengan-api-key-asli-kamu-di-sini

# Model untuk chat teks & coding
CHAT_MODEL=qwen-plus

# Model khusus untuk menganalisis gambar yang diupload (vision). Isi HANYA
# jika provider kamu punya model vision terpisah (contoh: qwen-vl-plus).
# Kalau dikosongkan, memakai CHAT_MODEL yang sama -- kalau modelnya tidak
# mendukung gambar, nanti muncul pesan error yang jelas saat dipakai.
CHAT_VISION_MODEL=

# Model untuk buat gambar (isi HANYA jika provider kamu mendukung endpoint
# /images/generations; kalau tidak yakin, cek dokumentasi provider kamu.
# Kalau dikosongkan, tombol "Gambar" tetap ada tapi akan menampilkan pesan
# error yang jelas kalau providernya memang tidak mendukung.)
CHAT_IMAGE_MODEL=

# ==== Identitas AI (opsional, jawaban ini dipakai kalau ditanya) ====
ASSISTANT_NAME=Nova AI
CREATOR_ANSWER=Saya dibuat dan dikembangkan secara mandiri oleh tim di balik aplikasi ini.
NAME_ANSWER=Nama saya Nova AI, asisten AI yang siap membantu kamu.

# ==== Sesi login pelanggan berlangganan (bukan NextAuth, cuma cookie ditandatangani) ====
# Isi string acak panjang, contoh: openssl rand -base64 32
SESSION_SECRET=

# ==== Firebase Realtime Database (simpan akun pelanggan berlangganan) ====
# 1) Buat project di https://console.firebase.google.com
# 2) Build -> Realtime Database -> Create Database (mode locked/production)
# 3) Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# URL Realtime Database, contoh: https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# ==== Pembayaran QRIS (api.buatqris.site) ====
BUATQRIS_BASE_URL=https://api.buatqris.site
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=

# ==== Kategori model AI ====
# Kategori 1 = gratis, dipakai pengguna baru otomatis (tanpa perlu isi apa pun
# di bawah ini kalau mau tetap pakai CHAT_MODEL yang sama seperti di atas).
CATEGORY_1_NAME=Nova Ai Kategori glm-5.3
# CATEGORY_1_MODEL=   # kosongkan untuk pakai CHAT_MODEL di atas

# Kategori 2 = berbayar Rp5.000, limit 4.000.000 token
CATEGORY_2_NAME=Nova Ai Kategori glm-5.3-flash
CATEGORY_2_MODEL=glm-5.3-flash
CATEGORY_2_PRICE=5000
CATEGORY_2_TOKEN_LIMIT=4000000

# Kategori 3 = berbayar Rp8.000, limit 8.000.000 token
CATEGORY_3_NAME=Nova Ai Kategori glm-5.3-flashx-mod
CATEGORY_3_MODEL=glm-5.3-flashx-mod
CATEGORY_3_PRICE=8000
CATEGORY_3_TOKEN_LIMIT=8000000

# (Opsional, per kategori) isi HANYA kalau kategori itu perlu API key/base
# URL/model-vision yang BEDA dari CHAT_API_KEY/CHAT_API_BASE_URL/CHAT_VISION_MODEL di atas:
# CATEGORY_2_API_BASE_URL=
# CATEGORY_2_API_KEY=
# CATEGORY_2_VISION_MODEL=
# CATEGORY_3_API_BASE_URL=
# CATEGORY_3_API_KEY=
# CATEGORY_3_VISION_MODEL=
